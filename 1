      return { phase, summary, protocol, exercises, modalities, contraindications };
    },
  },
};

/* ---------------------------------------------------------
   عارضه‌های تک‌گزینه‌ای (فعلاً فقط یک تشخیص شناخته‌شده در اپ دارند):
   همان مسیر غربالگری → توضیح → پروتکل طی می‌شود، فقط چون یک
   گزینه دارند صفحه‌ی «لیست کاندیدها» به‌طور خودکار رد می‌شود.
--------------------------------------------------------- */
function singleConditionScreening(diagKeyName) {
  const d = DIAGNOSES[diagKeyName];
  return {
    baselineSteps: d.steps,
    scoreFn: () => ({ [diagKeyName]: 100 }),
    conditions: {
      [diagKeyName]: { label: d.title, ...DIAGNOSIS_META[diagKeyName], extraSteps: [], compute: d.compute },
    },
  };
}

