            </div>
            <div className="bg-white border border-slate-200 rounded-xl p-4 mb-3">
              <div className="text-xs text-slate-500 font-medium mb-2 flex items-center gap-1"><CheckCircle2 size={14} className="text-teal-600" /> اصول کلی درمان</div>
              <ul className="space-y-2">
                {result.protocol.map((p, i) => (
                  <li key={i} className="text-sm text-slate-700 flex gap-2">
                    <span className="text-teal-600 mt-0.5">•</span>
                    <RichText text={p} onOpenTerm={setGlossaryTerm} />
                  </li>
                ))}
              </ul>
            </div>
            {result.exercises && result.exercises.length > 0 && (
              <div className="mb-3">
                <div className="text-xs text-slate-500 font-medium mb-2 px-1 flex items-center gap-1"><ClipboardList size={14} className="text-teal-600" /> تمرینات مشخص (نام، نحوه اجرا، دوز)</div>
                <div className="space-y-2">
                  {[...result.exercises, ...extraExercises].map((ex, i) => (
                    <div key={i} className="bg-teal-50 border border-teal-200 rounded-xl p-3">
                      <div className="font-semibold text-teal-900 text-sm mb-1">{i + 1}. {ex.name}</div>
                      <RichText text={ex.howTo} onOpenTerm={setGlossaryTerm} className="text-sm text-slate-700 leading-6 block mb-2" />
                      <div className="text-xs text-teal-800 bg-teal-100 rounded-lg px-2 py-1 inline-block">دوز: {ex.dosage}</div>
                    </div>
                  ))}
                </div>
                {(() => {
                  const pool = (ALT_EXERCISES[resultMeta.title] && ALT_EXERCISES[resultMeta.title][result.phase]) || [];
                  const hasMore = altIndex < pool.length;
                  return hasMore ? (
                    <button onClick={getNewExercise}
                      className="w-full mt-2 py-2.5 rounded-xl border border-dashed border-teal-300 text-teal-700 text-sm font-medium bg-white hover:bg-teal-50 flex items-center justify-center gap-2">
                      <Plus size={16} /> دریافت تمرین جدید
                    </button>
                  ) : (
                    altIndex > 0 && <p className="text-xs text-slate-400 text-center mt-2">تمرین جایگزین دیگری برای این فاز موجود نیست.</p>
                  );
                })()}
              </div>
            )}
            {result.modalities && result.modalities.length > 0 && (
              <div className="mb-3">
                <div className="text-xs text-slate-500 font-medium mb-2 px-1 flex items-center gap-1"><ClipboardList size={14} className="text-teal-600" /> تکنیک‌های دستی و مدالیته‌ها</div>
                <div className="space-y-2">
                  {result.modalities.map((m, i) => (
                    <div key={i} className="bg-slate-50 border border-slate-200 rounded-xl p-3">
                      <div className="font-semibold text-slate-800 text-sm mb-1">{i + 1}. {m.name}</div>
                      <RichText text={m.howTo} onOpenTerm={setGlossaryTerm} className="text-sm text-slate-700 leading-6 block mb-2" />
                      <div className="text-xs text-slate-700 bg-slate-200 rounded-lg px-2 py-1 inline-block">دوز: {m.dosage}</div>
                    </div>
                  ))}
                </div>
              </div>
            )}
            <div className="bg-rose-50 border border-rose-200 rounded-xl p-4 mb-4">
              <div className="text-xs text-rose-700 font-medium mb-2 flex items-center gap-1"><AlertTriangle size={14} /> موارد منع / هشدار</div>
              <ul className="space-y-2">
                {result.contraindications.map((c, i) => (
                  <li key={i} className="text-sm text-rose-800 flex gap-2">
                    <XCircle size={14} className="mt-0.5 shrink-0" />
                    <span>{c}</span>
                  </li>
                ))}
              </ul>
            </div>

            {studyMode ? (
              <button onClick={() => setView("studyPhasePick")}
                className="w-full bg-teal-700 text-white py-3 rounded-xl font-medium flex items-center justify-center gap-2">
                <ChevronRight size={18} /> مشاهده فاز دیگر همین عارضه
              </button>
            ) : saveState !== "saved" ? (
              <button onClick={saveAssessment} disabled={saveState === "saving"}
                className="w-full bg-teal-700 text-white py-3 rounded-xl font-medium flex items-center justify-center gap-2">
                {saveState === "saving" ? <Loader2 className="animate-spin" size={18} /> : <CheckCircle2 size={18} />}
                {saveState === "saving" ? "در حال ذخیره..." : "ذخیره در پرونده بیمار"}
              </button>
            ) : (
              <div className="w-full bg-teal-100 text-teal-800 py-3 rounded-xl font-medium flex items-center justify-center gap-2">
                <CheckCircle2 size={18} /> ذخیره شد
              </div>
            )}
            <button onClick={() => setView(studyMode ? "studyList" : "home")} className="w-full mt-3 text-slate-500 text-sm py-2">
              {studyMode ? "بازگشت به کتابخانه مطالعه" : "بازگشت به خانه"}
            </button>
          </div>
        )}
      </div>
    </div>
  );
}

/* ---------------------------------------------------------
   نصب برنامه روی صفحه
--------------------------------------------------------- */
const rootEl = document.getElementById("root");
const root = ReactDOM.createRoot(rootEl);
root.render(<OTApp licenseStatus="full" />);

</script>

</body>
</html>
