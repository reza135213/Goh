function computeFingersScores(a) {
  const clamp = (n) => Math.max(0, Math.min(100, n));
  let phalanx_fx = 0;
  if (a.mechanism === "به‌دنبال یک ضربه یا آسیب مشخص (مثلاً گیرکردن، مشت‌زدن یا خوردن ضربه)") phalanx_fx += 30;
  if (a.location === "بند انگشت (فالانکس)") phalanx_fx += 25;
  if (a.swelling) phalanx_fx += 25;
  if (a.locking) phalanx_fx -= 20;
  phalanx_fx = clamp(phalanx_fx);

  let trigger = 0;
  if (a.mechanism === "به‌تدریج و بدون آسیب مشخص") trigger += 30;
  if (a.locking) trigger += 35;
  if (a.nodule) trigger += 25;
  if (a.swelling) trigger -= 15;
  trigger = clamp(trigger);

  let metacarpal_fx = 0;
  if (a.mechanism === "به‌دنبال یک ضربه یا آسیب مشخص (مثلاً گیرکردن، مشت‌زدن یا خوردن ضربه)") metacarpal_fx += 30;
  if (a.location === "کف دست، بین انگشتان و مچ (متاکارپ)") metacarpal_fx += 40;
  if (a.swelling) metacarpal_fx += 20;
  metacarpal_fx = clamp(metacarpal_fx);

  let thumb_ucl_sprain = 0;
  if (a.location === "قاعده شست، نزدیک مچ") thumb_ucl_sprain += 30;
  if (a.thumbHyperextension) thumb_ucl_sprain += 40;
  if (a.swelling) thumb_ucl_sprain += 15;
  thumb_ucl_sprain = clamp(thumb_ucl_sprain);

  return { phalanx_fx, trigger, metacarpal_fx, thumb_ucl_sprain };
}

