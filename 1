    instructions: "از بیمار بخواهید فقط روی پای درگیر بایستد (پای مقابل را از زمین بلند کند) و چند ثانیه نگه دارد.",
    positiveCriteria: "افت محسوس لگن در سمت پای بلندشده (مقابل)، نشانه ضعف عضلات ابداکتور هیپ سمت درگیر." },
];

function computeHipScores(a) {
  const clamp = (n) => Math.max(0, Math.min(100, n));
  const trauma = a.mechanism === "بله، به‌دنبال افتادن یا ضربه مستقیم به لگن/هیپ";

  let trochanteric_bursitis = 0;
  if (!trauma) trochanteric_bursitis += 20;
  if (a.sideLying) trochanteric_bursitis += 30;
  if (a.stairsPain) trochanteric_bursitis += 20;
  if (a.trendelenburg) trochanteric_bursitis += 20;
  if (a.weightBearing === false) trochanteric_bursitis -= 30;
  if (a.legShortDeform) trochanteric_bursitis -= 30;
  trochanteric_bursitis = clamp(trochanteric_bursitis);

  let hip_fracture = 0;
  if (trauma) hip_fracture += 35;
  if (a.weightBearing === false) hip_fracture += 30;
  if (a.legShortDeform) hip_fracture += 35;
  hip_fracture = clamp(hip_fracture);

  return { trochanteric_bursitis, hip_fracture };
}

