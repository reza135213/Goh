/* ---------------------------------------------------------
   لیست مسطح همه‌ی عارضه‌های موجود در اپ، برای مسیر
   «لیست بیماری‌ها» — وقتی درمانگر از قبل تشخیص را می‌داند
   و می‌خواهد مستقیم به بخش آموزش و پروتکل برود.
--------------------------------------------------------- */
const ALL_CONDITIONS = (() => {
  const list = [];
  REGIONS.forEach((region) => {
    region.subregions.forEach((sub) => {
      const scr = REGION_SCREENINGS[sub.id];
      if (!scr) return;
      Object.entries(scr.conditions).forEach(([key, cond]) => {
        list.push({ regionLabel: region.label, subregionId: sub.id, subregionLabel: sub.label, conditionKey: key, label: cond.label });
      });
    });
  });
  return list;
})();

/* ---------------------------------------------------------
   نسخه دمو: از هر کمپارتمان (زیرناحیه) فقط یک عارضه باز است —
   انتخاب‌شده بر اساس شناخته‌شدگی/جذابیت برای نمایش دمو.
   بقیه‌ی عارضه‌های همان زیرناحیه در دمو قفل نشان داده می‌شوند.
--------------------------------------------------------- */
const DEMO_ALLOWED_CONDITIONS = new Set([
  // ۴ مورد اول لیست قبلی
  "impingement",           // شانه
  "cts",                   // مچ — سندرم تونل کارپال
  "trigger",               // انگشتان — تریگر فینگر
  "tennis",                // آرنج — تنیس البو
  // کل ماژول ارزیابی شانه (برای نمایش کامل موتور تشخیص افتراقی)
  "frozen",
  "instability",
  "cuff_tear",
  "proximal_humerus_fx",
  "clavicle_fx",
  "ac_joint_sprain",
]);

function isDemoLocked(conditionKey, licenseStatus) {
  return licenseStatus !== "full" && !DEMO_ALLOWED_CONDITIONS.has(conditionKey);
}

