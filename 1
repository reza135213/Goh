function computeAnkleScores(a) {
  const clamp = (n) => Math.max(0, Math.min(100, n));
  let ankle_sprain = 0;
  if (a.mechanism === "پیچش به داخل مچ پا (اینورژن) حین راه‌رفتن/ورزش") ankle_sprain += 25;
  if (a.weightBearing) ankle_sprain += 15;
  if (a.anteriorDrawer) ankle_sprain += 25;
  if (a.edema) ankle_sprain += 15;
  if (a.boneTenderness) ankle_sprain -= 30;
  if (a.deformity) ankle_sprain -= 30;
  ankle_sprain = clamp(ankle_sprain);

  let ankle_fracture = 0;
  if (a.mechanism === "ضربه مستقیم یا افتادن با نیروی زیاد روی مچ پا") ankle_fracture += 20;
  if (a.boneTenderness) ankle_fracture += 35;
  if (a.weightBearing === false) ankle_fracture += 30;
  if (a.deformity) ankle_fracture += 35;
  ankle_fracture = clamp(ankle_fracture);

  return { ankle_sprain, ankle_fracture };
}

