  if (a.immediateSwelling) pfps -= 25;
  if (a.instabilityFeel) pfps -= 20;
  pfps = clamp(pfps);

  let acl_mcl_sprain = 0;
  if (a.mechanism === "ضربه یا چرخش ناگهانی حین ورزش/فعالیت (مثل تغییر جهت ناگهانی یا برخورد)") acl_mcl_sprain += 25;
