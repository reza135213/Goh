/* ---------------------------------------------------------
   NOTE: ذخیره‌سازی پایدار (window.storage) فعلاً موقتاً غیرفعال است
   تا روی منطق و جریان کار اپ توافق شود. داده‌ها فقط در همین
   جلسه (state داخل مرورگر) نگه داشته می‌شوند و با بستن اپ پاک می‌شوند.
--------------------------------------------------------- */

/* ---------------------------------------------------------
   اپلیکیشن اصلی
--------------------------------------------------------- */
function OTApp({ licenseStatus = "full", supabase, userId }) {
  const [termsAccepted, setTermsAccepted] = useState(false);
  const [view, setView] = useState("landing");
  const [patients, setPatients] = useState([]); // [{id,name,createdAt,assessments:[]}]
  const [activePatient, setActivePatient] = useState(null);
  const [newPatientName, setNewPatientName] = useState("");
  const [region, setRegion] = useState(null);
  const [subregion, setSubregion] = useState(null);
  const [stepIndex, setStepIndex] = useState(0);
  const [answers, setAnswers] = useState({});
  const [result, setResult] = useState(null);
  const [resultMeta, setResultMeta] = useState(null); // { title, definition?, mechanism? }
  const [glossaryTerm, setGlossaryTerm] = useState(null);
  const [saveState, setSaveState] = useState("idle");
  const [error, setError] = useState("");

  // موتور غربالگری عمومی (برای همه‌ی زیرناحیه‌ها یکسان است)
  const [screening, setScreening] = useState(null); // = REGION_SCREENINGS[subregion.id]
  const [wizardStage, setWizardStage] = useState("baseline"); // baseline | extra
  const [baselineAnswers, setBaselineAnswers] = useState({});
  const [scores, setScores] = useState(null);
  const [selectedCondition, setSelectedCondition] = useState(null);
  const [extraExercises, setExtraExercises] = useState([]);
  const [altIndex, setAltIndex] = useState(0);

  // حالت «کتابخانه مطالعه» (بدون بیمار، فقط مرور تعریف/پروتکل)
  const [studyMode, setStudyMode] = useState(false);
  const [studySelected, setStudySelected] = useState(null); // { item, cond }
  const [studyPhaseOptions, setStudyPhaseOptions] = useState([]);
  const [selectedTechnique, setSelectedTechnique] = useState(null);

  const resetFlow = () => {
    setRegion(null); setSubregion(null);
    setStepIndex(0); setAnswers({}); setResult(null); setResultMeta(null); setSaveState("idle");
    setScreening(null); setWizardStage("baseline"); setBaselineAnswers({}); setScores(null); setSelectedCondition(null);
    setExtraExercises([]); setAltIndex(0);
    setStudyMode(false); setStudySelected(null); setStudyPhaseOptions([]);
  };

  const openStudyLibrary = () => {
    resetFlow();
    setStudyMode(true);
    setView("studyList");
  };

  const showLocked = (label) => {
    setResultMeta({ title: label });
    setView("locked");
  };

  const selectStudyCondition = (item) => {
    if (isDemoLocked(item.conditionKey, licenseStatus)) { showLocked(item.label); return; }
    const scr = REGION_SCREENINGS[item.subregionId];
    const cond = scr.conditions[item.conditionKey];
    const variants = (STUDY_VARIANTS[item.conditionKey] || [{}]).map((v) => ({ answers: v, ...cond.compute(v) }));
    const seen = new Set();
    const uniqueVariants = variants.filter((v) => (seen.has(v.phase) ? false : (seen.add(v.phase), true)));
    setStudySelected({ item, cond });
    setStudyPhaseOptions(uniqueVariants);
    setView("studyPhasePick");
  };

  const selectStudyPhase = (variant) => {
    const { cond } = studySelected;
    setResult(variant);
    setResultMeta({ title: cond.label, definition: cond.definition, mechanism: cond.mechanism });
    setExtraExercises([]); setAltIndex(0);
    setView("explain");
  };

  const startNewAssessment = (patient) => {
    setActivePatient(patient);
    resetFlow();
    setView("assessmentChoice");
  };

  const createPatient = () => {
    const name = newPatientName.trim();
    if (!name) return;
    const id = "p_" + Date.now();
    const patient = { id, name, createdAt: new Date().toISOString(), assessments: [] };
    setPatients((prev) => [...prev, patient]);
    setNewPatientName("");
    startNewAssessment(patient);
  };

  const openPatientHistory = (p) => {
    setActivePatient(p);
    setView("history");
  };

  const startScreening = (subregionObj) => {
    const scr = REGION_SCREENINGS[subregionObj.id];
    setScreening(scr);
    setWizardStage("baseline");
    setStepIndex(0); setAnswers({});
    setBaselineAnswers({}); setScores(null); setSelectedCondition(null);
    setExtraExercises([]); setAltIndex(0);
    setView("wizard");
  };

  const startDirectCondition = (item) => {
    if (isDemoLocked(item.conditionKey, licenseStatus)) { showLocked(item.label); return; }
    const scr = REGION_SCREENINGS[item.subregionId];
    setRegion({ label: item.regionLabel });
    setSubregion({ label: item.subregionLabel, id: item.subregionId });
    setScreening(scr);
    setSelectedCondition(item.conditionKey);
    setWizardStage("direct");
    setStepIndex(0); setAnswers({});
    setBaselineAnswers({}); setScores(null);
    setExtraExercises([]); setAltIndex(0);
    setView("wizard");
  };

  const steps = !screening ? []
    : wizardStage === "baseline" ? screening.baselineSteps
    : wizardStage === "direct" ? [...screening.baselineSteps, ...screening.conditions[selectedCondition].extraSteps]
    : screening.conditions[selectedCondition].extraSteps;
  const currentStep = steps[stepIndex];

  const canProceed = () => {
    if (!currentStep) return false;
    const v = answers[currentStep.key];
    if (currentStep.type === "bool" || currentStep.type === "test") return v === true || v === false;
    if (currentStep.type === "select") return !!v;
    if (currentStep.type === "number") return v !== undefined && v !== "" && !isNaN(v);
    return false;
  };

  const finalizeCondition = (key, combinedAnswers) => {
    const cond = screening.conditions[key];
    const r = cond.compute(combinedAnswers);
    setSelectedCondition(key);
    setResult(r);
    setResultMeta({ title: cond.label, definition: cond.definition, mechanism: cond.mechanism });
    setExtraExercises([]); setAltIndex(0);
    setView("explain");
  };

  const getNewExercise = () => {
    const pool = (ALT_EXERCISES[resultMeta.title] && ALT_EXERCISES[resultMeta.title][result.phase]) || [];
    if (altIndex < pool.length) {
      setExtraExercises([...extraExercises, pool[altIndex]]);
      setAltIndex(altIndex + 1);
    }
  };

  const finishWizard = () => {
    if (wizardStage === "baseline") {
      const sc = screening.scoreFn(answers);
      setBaselineAnswers(answers);
      setScores(sc);
      const keys = Object.keys(sc);
      if (keys.length === 1) {
        if (isDemoLocked(keys[0], licenseStatus)) { showLocked(screening.conditions[keys[0]].label); return; }
        finalizeCondition(keys[0], answers);
      } else {
        setView("candidates");
      }
    } else if (wizardStage === "direct") {
      finalizeCondition(selectedCondition, answers);
    } else {
      const combined = { ...baselineAnswers, ...answers };
      finalizeCondition(selectedCondition, combined);
    }
  };

  const selectCandidate = (key) => {
    const cond = screening.conditions[key];
    if (isDemoLocked(key, licenseStatus)) { showLocked(cond.label); return; }
    if (cond.extraSteps.length === 0) {
      finalizeCondition(key, baselineAnswers);
    } else {
      setSelectedCondition(key);
      setWizardStage("extra");
      setStepIndex(0); setAnswers({});
      setView("wizard");
    }
  };

  const nextStep = () => {
    if (stepIndex < steps.length - 1) setStepIndex(stepIndex + 1);
    else finishWizard();
  };

  const saveAssessment = () => {
    setSaveState("saving");
    const record = {
      date: new Date().toISOString(),
      diagTitle: resultMeta.title,
      region: region.label, subregion: subregion.label,
      result,
    };
    const updated = { ...activePatient, assessments: [...(activePatient.assessments || []), record] };
    setPatients((prev) => prev.map((p) => (p.id === updated.id ? updated : p)));
    setActivePatient(updated);
    setSaveState("saved");
  };

  const Header = ({ title, onBack }) => (
    <div className="flex items-center gap-3 mb-5">
      {onBack && (
        <button onClick={onBack} className="p-2 rounded-full hover:bg-slate-100 text-slate-600">
          <ChevronRight size={20} />
        </button>
      )}
      <h1 className="display text-2xl text-teal-900">{title}</h1>
    </div>
  );

  return (
    <div className="ot-app min-h-screen bg-slate-50" dir="rtl" style={{ fontFamily: "'Vazirmatn', sans-serif" }}>
      <FontLoader />
      <GlossaryModal term={glossaryTerm} onClose={() => setGlossaryTerm(null)} />

      <div className="max-w-md mx-auto px-4 py-6 pb-16">
        {/* نوار بالا */}
        <div className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-2">
            <div className="w-9 h-9 rounded-xl bg-teal-700 flex items-center justify-center text-white font-bold">OT</div>
            <span className="display text-lg text-teal-900">دستیار درمانگر - ارتوپدی</span>
          </div>
          {view !== "home" && view !== "landing" && (
            <button onClick={() => { resetFlow(); setView("home"); }}
              className="p-2 rounded-full hover:bg-slate-100 text-slate-500" aria-label="بازگشت به صفحه اصلی">
              <Home size={20} />
            </button>
          )}
        </div>

        {error && (
          <div className="mb-4 bg-rose-50 border border-rose-200 text-rose-700 text-sm rounded-lg p-3 flex justify-between items-center">
            {error}
            <button onClick={() => setError("")}><X size={16} /></button>
          </div>
        )}

        {view === "landing" && (
          <div className="space-y-4">
            <button onClick={() => setView("terms")}
              className="text-sm text-teal-700 underline decoration-dotted flex items-center gap-1">
              <Info size={14} /> مشاهده قوانین
            </button>
            <div className="flex items-center gap-2 -mt-2">
              <button
                onClick={() => setTermsAccepted((v) => !v)}
                className={`w-5 h-5 rounded border flex items-center justify-center shrink-0 ${termsAccepted ? "bg-teal-700 border-teal-700" : "bg-white border-slate-300"}`}
                aria-label="پذیرش قوانین"
              >
                {termsAccepted && <CheckCircle2 size={14} className="text-white" />}
              </button>
              <span className="text-sm text-slate-600">پذیرش</span>
            </div>
            <button
              onClick={() => setView("home")}
              className="w-full bg-teal-700 hover:bg-teal-800 text-white rounded-2xl p-5 flex items-center justify-center gap-2 shadow-sm font-medium"
            >
              ورود به اپلیکیشن <ArrowRight size={18} />
            </button>
          </div>
        )}

        {view === "terms" && (
          <div>
            <Header title="قوانین استفاده" onBack={() => setView("landing")} />
            <div className="bg-white border border-slate-200 rounded-xl p-4 mb-4 space-y-4">
              {TERMS_SECTIONS.map((s, i) => (
                <div key={i}>
                  <div className="font-semibold text-slate-800 text-sm mb-1">{s.title}</div>
                  <p className="text-sm text-slate-700 leading-7">{s.body}</p>
                </div>
              ))}
            </div>
            {!termsAccepted ? (
              <button
                onClick={() => { setTermsAccepted(true); setView("landing"); }}
                className="w-full bg-teal-700 hover:bg-teal-800 text-white rounded-xl py-3 font-medium flex items-center justify-center gap-2"
              >
                <CheckCircle2 size={18} /> پذیرش
              </button>
            ) : (
              <div className="w-full bg-teal-100 text-teal-800 py-3 rounded-xl font-medium flex items-center justify-center gap-2">
                <CheckCircle2 size={18} /> قوانین پذیرفته شده است
              </div>
            )}
          </div>
        )}

        {view === "home" && (
          <div className="space-y-4">
            {licenseStatus !== "full" && (
              <div className="bg-amber-50 border border-amber-200 rounded-xl p-3 text-sm text-amber-800">
                نسخه دمو فعال است — «ارزیابی جدید» و ذخیره‌ی بیمار غیرفعال است.{" "}
                <a href="/activate" className="underline font-medium">فعال‌سازی نسخه کامل</a>
              </div>
            )}
            <button
              onClick={() => licenseStatus === "full" && setView("selectPatientForNew")}
              disabled={licenseStatus !== "full"}
              className={`w-full rounded-2xl p-5 flex items-center justify-between shadow-sm ${licenseStatus === "full" ? "bg-teal-700 hover:bg-teal-800 text-white" : "bg-slate-100 text-slate-400 cursor-not-allowed"}`}
            >
              <div className="text-right">
                <div className="font-bold text-lg">ارزیابی جدید</div>
                <div className={`text-sm ${licenseStatus === "full" ? "text-teal-100" : "text-slate-400"}`}>شروع فرآیند ارزیابی و پلن‌نویسی</div>
              </div>
              <ClipboardList size={28} />
            </button>
            <button
              onClick={() => licenseStatus === "full" && setView("patients")}
              disabled={licenseStatus !== "full"}
              className={`w-full rounded-2xl p-5 flex items-center justify-between shadow-sm border ${licenseStatus === "full" ? "bg-white border-slate-200 hover:border-teal-300" : "bg-slate-100 border-slate-200 text-slate-400 cursor-not-allowed"}`}
            >
              <div className="text-right">
                <div className="font-bold text-lg text-slate-800">بیماران من</div>
                <div className="text-slate-500 text-sm">{patients.length} بیمار ثبت‌شده</div>
              </div>
              <User size={28} className="text-teal-700" />
            </button>
            <button
              onClick={openStudyLibrary}
              className="w-full bg-white border border-slate-200 hover:border-teal-300 rounded-2xl p-5 flex items-center justify-between shadow-sm"
            >
              <div className="text-right">
                <div className="font-bold text-lg text-slate-800">کتابخانه مطالعه</div>
                <div className="text-slate-500 text-sm">بدون بیمار — مستقیم تعریف، مکانیزم و پروتکل هر عارضه را ببینید</div>
              </div>
              <Info size={28} className="text-teal-700" />
            </button>
