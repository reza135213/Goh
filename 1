function computeWristScores(a) {
  const clamp = (n) => Math.max(0, Math.min(100, n));
  const trauma = a.mechanism === "بله، به‌دنبال افتادن روی دست کشیده‌شده یا ضربه مستقیم به مچ";

  let cts = 0;
  if (a.painLocation === "سطح کف‌دستی مچ و انگشتان (همراه با بی‌حسی/گزگز)") cts += 25;
  if (a.numbness) cts += 30;
  if (a.nightSx) cts += 15;
  if (a.phalen) cts += 20;
  if (a.tinel) cts += 15;
  if (a.deformity) cts -= 30;
  cts = clamp(cts);

  let dequervain = 0;
  if (a.painLocation === "سطح رادیال مچ نزدیک قاعده شست (بدون بی‌حسی، بیشتر با حرکت شست)") dequervain += 25;
  if (a.thumbMovePain) dequervain += 25;
  if (a.finkelstein) dequervain += 30;
  if (a.numbness) dequervain -= 15;
  if (a.deformity) dequervain -= 30;
  dequervain = clamp(dequervain);

  let distal_radius_fx = 0;
  if (trauma) distal_radius_fx += 40;
  if (a.swelling) distal_radius_fx += 25;
  if (a.deformity) distal_radius_fx += 35;
  distal_radius_fx = clamp(distal_radius_fx);

  let tfcc = 0;
  if (a.painLocation === "سطح اولنار مچ (سمت انگشت کوچک)") tfcc += 35;
  if (a.clickWithRotation) tfcc += 30;
  if (a.deformity) tfcc -= 20;
  tfcc = clamp(tfcc);

  return { cts, dequervain, distal_radius_fx, tfcc };
}

