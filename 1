function computeShoulderScores(a) {
  const dur = Number(a.duration) || 0;
  const aromFlex = Number(a.aromFlex) || 0;
  const promFlex = Number(a.promFlex) || 0;
  const promER = Number(a.promER) || 0;
  const clamp = (n) => Math.max(0, Math.min(100, n));

  let impingement = 0;
  if (a.mechanism === "فعالیت تکراری بالای سر (شغلی/ورزشی)") impingement += 20;
  if (a.onset === "تدریجی و بدون علت مشخص") impingement += 10;
  if (a.nightPain) impingement += 10;
  if (a.painfulArc) impingement += 20;
  if (a.neer) impingement += 15;
  if (a.hawkins) impingement += 15;
  if (a.globalStiff) impingement -= 25;
  if (a.weaknessSinceInjury) impingement -= 10;
  impingement = clamp(impingement);

  let frozen = 0;
  if (a.globalStiff) frozen += 35;
  if (promER > 0 && promER < 30) frozen += 20;
  if (aromFlex > 0 && promFlex - aromFlex < 15 && aromFlex < 100) frozen += 15;
  if (a.onset === "تدریجی و بدون علت مشخص") frozen += 10;
  if (dur > 6) frozen += 10;
  if (a.nightPain) frozen += 10;
  if (a.instabilityFeel) frozen -= 15;
  if (a.weaknessSinceInjury) frozen -= 15;
  frozen = clamp(frozen);

  let instability = 0;
  if (a.instabilityFeel) instability += 35;
  if (a.apprehensionFeel) instability += 30;
  if (a.mechanism === "افتادن روی دست کشیده‌شده یا ضربه مستقیم به شانه") instability += 20;
  if (a.onset === "ناگهانی (بعد از یک ضربه/افتادن/حرکت مشخص)") instability += 10;
  if (a.globalStiff) instability -= 20;
  instability = clamp(instability);

  let cuff_tear = 0;
  if (a.weaknessSinceInjury) cuff_tear += 35;
  if (a.mechanism === "بلندکردن ناگهانی وزنه سنگین یا حرکت پرتابی") cuff_tear += 20;
  if (a.onset === "ناگهانی (بعد از یک ضربه/افتادن/حرکت مشخص)") cuff_tear += 10;
  if (a.jobe) cuff_tear += 20;
  if (a.nightPain) cuff_tear += 10;
  if (a.globalStiff) cuff_tear -= 20;
  cuff_tear = clamp(cuff_tear);

  let proximal_humerus_fx = 0;
  if (a.mechanism === "افتادن روی دست کشیده‌شده یا ضربه مستقیم به شانه") proximal_humerus_fx += 30;
  if (a.onset === "ناگهانی (بعد از یک ضربه/افتادن/حرکت مشخص)") proximal_humerus_fx += 15;
  if (a.severeSwelling) proximal_humerus_fx += 35;
  if (a.weaknessSinceInjury) proximal_humerus_fx += 15;
  if (a.traumaPainLocation === "عمق مفصل شانه یا بازوی فوقانی") proximal_humerus_fx += 10;
  if (a.visibleBump) proximal_humerus_fx -= 15;
  proximal_humerus_fx = clamp(proximal_humerus_fx);

  let clavicle_fx = 0;
  if (a.mechanism === "افتادن روی دست کشیده‌شده یا ضربه مستقیم به شانه") clavicle_fx += 25;
  if (a.onset === "ناگهانی (بعد از یک ضربه/افتادن/حرکت مشخص)") clavicle_fx += 15;
  if (a.traumaPainLocation === "بالای شانه، دقیقاً روی خط ترقوه (استخوان راست جلوی شانه)") clavicle_fx += 30;
  if (a.visibleBump) clavicle_fx += 30;
  if (a.severeSwelling) clavicle_fx += 10;
  clavicle_fx = clamp(clavicle_fx);

  let ac_joint_sprain = 0;
  if (a.traumaPainLocation === "نوک شانه، دقیقاً روی برجستگی بین ترقوه و کتف (AC Joint)") ac_joint_sprain += 40;
  if (a.mechanism === "افتادن روی دست کشیده‌شده یا ضربه مستقیم به شانه") ac_joint_sprain += 15;
  if (a.onset === "ناگهانی (بعد از یک ضربه/افتادن/حرکت مشخص)") ac_joint_sprain += 10;
  if (a.visibleBump) ac_joint_sprain += 20;
  ac_joint_sprain = clamp(ac_joint_sprain);

  return { impingement, frozen, instability, cuff_tear, proximal_humerus_fx, clavicle_fx, ac_joint_sprain };
}

