<script>
  // بارگذاری چند-CDNی با fallback: اگر یک CDN در دسترس نبود، خودکار سراغ بعدی می‌رود.
  function loadScriptWithFallback(urls, onDone) {
    var i = 0;
    function tryNext() {
      if (i >= urls.length) { onDone(false); return; }
      var url = urls[i++];
      var s = document.createElement('script');
      s.src = url;
      s.crossOrigin = 'anonymous';
      s.onload = function () { onDone(true); };
      s.onerror = function () { tryNext(); };
      document.head.appendChild(s);
    }
    tryNext();
  }

  function loadSeq(steps, finalCb) {
    var idx = 0;
    function next() {
      if (idx >= steps.length) { finalCb(true); return; }
      var step = steps[idx++];
      loadScriptWithFallback(step, function (ok) {
        if (!ok) { finalCb(false); return; }
        next();
      });
    }
    next();
  }

  var BOOT_TIMEOUT_MS = 20000;
  var bootFinished = false;
  var bootTimer = setTimeout(function () {
    if (!bootFinished) showBootError();
  }, BOOT_TIMEOUT_MS);

  function showBootError() {
    var el = document.getElementById('boot-status');
    if (el) el.className = 'failed';
  }
  function hideBootStatus() {
    bootFinished = true;
    clearTimeout(bootTimer);
    var el = document.getElementById('boot-status');
    if (el) el.className = 'hidden';
  }

  loadSeq([
    // React 18
    [
      'https://unpkg.com/react@18/umd/react.production.min.js',
      'https://cdn.jsdelivr.net/npm/react@18/umd/react.production.min.js',
      'https://cdnjs.cloudflare.com/ajax/libs/react/18.3.1/umd/react.production.min.js'
    ],
    // ReactDOM 18
    [
      'https://unpkg.com/react-dom@18/umd/react-dom.production.min.js',
      'https://cdn.jsdelivr.net/npm/react-dom@18/umd/react-dom.production.min.js',
      'https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.3.1/umd/react-dom.production.min.js'
    ],
    // Babel standalone (transforms the JSX below directly in the browser)
    [
      'https://unpkg.com/@babel/standalone/babel.min.js',
      'https://cdn.jsdelivr.net/npm/@babel/standalone/babel.min.js',
      'https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.24.7/babel.min.js'
    ],
    // Tailwind CSS (JIT runtime)
    [
      'https://cdn.tailwindcss.com',
      'https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4'
    ]
  ], function (ok) {
    if (!ok) { showBootError(); return; }

    // همه‌ی کتابخانه‌ها بارگذاری شدند: کد JSX اپلیکیشن را با Babel به‌صورت دستی تبدیل و اجرا می‌کنیم
    // (چون این اسکریپت پس از اجرای اولیه‌ی Babel به صفحه اضافه شده، اسکن خودکار آن را نمی‌بیند).
    try {
      var source = document.getElementById('app-source').textContent;
      var compiled = Babel.transform(source, { presets: ['react'] }).code;
      var appScript = document.createElement('script');
      appScript.text = compiled;
      document.body.appendChild(appScript);
    } catch (e) {
      console.error('Babel transform/execute error:', e);
      showBootError();
      return;
    }

    // بررسی این‌که آیا React واقعاً چیزی داخل #root رندر کرد یا نه
    setTimeout(function () {
      var root = document.getElementById('root');
      if (root && root.innerHTML.trim().length > 0) {
        hideBootStatus();
      } else {
        showBootError();
      }
    }, 3000);
  });
</script>

