function computeKneeScores(a) {
  const clamp = (n) => Math.max(0, Math.min(100, n));
  let pfps = 0;
  if (a.mechanism === "تدریجی و بدون ضربه مشخص (مثلاً درد تدریجی جلوی زانو)") pfps += 15;
  if (a.painStairs) pfps += 20;
