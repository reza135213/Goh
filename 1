}

/* یک متن که به‌صورت خودکار اصطلاحات واژه‌نامه را لینک می‌کند */
function RichText({ text, onOpenTerm, className }) {
  const terms = Object.keys(GLOSSARY).sort((a, b) => b.length - a.length);
  let parts = [text];
  terms.forEach((term) => {
    const next = [];
    parts.forEach((part) => {
      if (typeof part !== "string") { next.push(part); return; }
      const split = part.split(term);
      split.forEach((seg, i) => {
        next.push(seg);
        if (i < split.length - 1) next.push({ term });
      });
    });
    parts = next;
  });
  return (
    <span className={className}>
      {parts.map((p, i) =>
        typeof p === "string" ? (
          <React.Fragment key={i}>{p}</React.Fragment>
        ) : (
          <Term key={i} onOpen={onOpenTerm}>{p.term}</Term>
        )
      )}
    </span>
  );
}

function GlossaryModal({ term, onClose }) {
  if (!term) return null;
  const diagram = DIAGRAMS[term];
  return (
    <div className="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-900/50 p-4" onClick={onClose}>
      <div
        className="bg-white rounded-2xl shadow-xl max-w-md w-full p-5 max-h-[80vh] overflow-y-auto"
        onClick={(e) => e.stopPropagation()}
      >
        <div className="flex items-start justify-between mb-3">
          <h3 className="display text-xl text-teal-800">{term}</h3>
          <button onClick={onClose} className="text-slate-400 hover:text-slate-700 p-1"><X size={20} /></button>
        </div>
        {diagram && <div className="mb-3 bg-teal-50 rounded-xl p-3">{diagram}</div>}
        <p className="text-slate-700 leading-7 text-sm">{GLOSSARY[term]}</p>
      </div>
    </div>
  );
}

