  if (a.immediateSwelling) acl_mcl_sprain += 30;
  if (a.instabilityFeel) acl_mcl_sprain += 25;
  acl_mcl_sprain = clamp(acl_mcl_sprain);

  return { pfps, acl_mcl_sprain };
}

